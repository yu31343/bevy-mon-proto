            element: Some(Fire),
        ),
        (
            id: ElementGrassAttack,
            name: "草叶斩击",
            effect: Attack(power: 12),
            element: Some(Grass),
        ),
        (
            id: ElementLightAttack,
            name: "光辉之刃",
            effect: Attack(power: 14),
            element: Some(Light),
        ),
        (
            id: ElementDarkAttack,
            name: "暗影切割",
            effect: Attack(power: 14),
            element: Some(Dark),
        ),
        (
            id: ElementThunderAttack,
            name: "雷霆打击",
            effect: Attack(power: 14),
            element: Some(Thunder),
        ),
        (
            id: ElementWindAttack,
            name: "风刃疾袭",
            effect: Attack(power: 14),
            element: Some(Wind),
        ),
        (
            id: FirstAid,
            name: "急救",
            effect: Heal(amount: 12),
            element: None,
        ),
        (
            id: Guard,
            name: "防御",
            effect: Shield(amount: 10),
            element: None,
        ),
    ],
    monsters: [
        (
            name: "水精灵",
            element: Water,
            stats: (hp: 100, atk: 16, def: 10, spd: 12),
            skills: (NormalAttack, ElementWaterAttack, Guard, FirstAid),
        ),
        (
            name: "草精灵",
            element: Grass,
            stats: (hp: 80, atk: 14, def: 12, spd: 15),
            skills: (NormalAttack, ElementGrassAttack, Guard, FirstAid),
