//注意发布最终独立exe时要将读取到的数据嵌入可执行文件中

(
    // 元素克制矩阵：定义各元素之间的伤害倍率（暂时不考虑克制关系，但保留接口）
    // 克制=2.0，微弱=0.5，未定义的组合默认为1.0
    element_matrix: (
        relations: [
            // 光/暗互克
            (attacker: Light, defender: Dark, multiplier: 1.0),
            (attacker: Dark, defender: Light, multiplier: 1.0),

            // 水/火/草循环
            (attacker: Water, defender: Fire, multiplier: 1.0),
            (attacker: Fire, defender: Grass, multiplier: 1.0),
            (attacker: Grass, defender: Water, multiplier: 1.0),
            (attacker: Water, defender: Grass, multiplier: 1.0),
            (attacker: Fire, defender: Water, multiplier: 1.0),
            (attacker: Grass, defender: Fire, multiplier: 1.0),

            // 雷/水/风关系
            (attacker: Thunder, defender: Water, multiplier: 1.0),
            (attacker: Water, defender: Thunder, multiplier: 1.0),
            (attacker: Thunder, defender: Wind, multiplier: 1.0),
            (attacker: Wind, defender: Thunder, multiplier: 1.0),
            (attacker: Thunder, defender: Grass, multiplier: 1.0),

            // 风/草/火关系
            (attacker: Wind, defender: Grass, multiplier: 1.0),
            (attacker: Fire, defender: Wind, multiplier: 1.0),
            (attacker: Wind, defender: Fire, multiplier: 1.0),
        ],
    ),

    rules: (
        max_team_size: 3,   //这里暂时不能超过3
